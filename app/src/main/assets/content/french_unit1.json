          "explanation": "\"S'il vous plaît\" is formal or plural; \"s'il te plaît\" is for friends."
        },
        {
          "type": "match_pairs",
          "pairs": [["Pardon", "Sorry"], ["Excusez-moi", "Excuse me"], ["De rien", "You're welcome"], ["Bonne journée", "Have a good day"]],
          "explanation": "\"De rien\" means \"of nothing\" — the standard reply to merci."
        },
        {
          "type": "multiple_choice",
          "prompt": "Someone says \"Merci\". What do you answer?",
          "options": ["De rien", "Bonjour", "Pardon", "Au revoir"],
          "correctIndex": 0,
          "explanation": "\"De rien\", \"je vous en prie\" or \"pas de problème\" all work as \"you're welcome\"."
        },
        {
          "type": "fill_blank",
          "sentence": "___-moi, où est la gare ?",
          "answer": "Excusez",
          "wordBank": ["Excusez", "Excuse", "Pardon", "S'il"],
          "explanation": "\"Excusez-moi\" politely gets attention before asking something."
        },
        {
          "type": "listening",
          "text": "Je vous en prie",
          "options": ["You're welcome (formal)", "Please sit down", "I beg your pardon", "See you soon"],
          "correctIndex": 0,
          "explanation": "\"Je vous en prie\" is the most formal way to say \"you're welcome\"."
        },
        {
          "type": "multiple_choice",
          "prompt": "How do you say \"sorry\"?",
          "options": ["Désolé", "Merci", "Bonjour", "Voilà"],
          "correctIndex": 0,
          "explanation": "\"Désolé\" (or \"désolée\" if you're a woman) means \"sorry\"."
        },
        {
          "type": "fill_blank",
          "sentence": "Bonne ___ !",
          "answer": "journée",
          "wordBank": ["journée", "nuit", "soir", "matin"],
          "explanation": "\"Bonne journée\" = \"have a good day\" — said when leaving during daytime."
        },
        {
          "type": "pronunciation",
          "expected": "Pardon, je suis désolé",
          "translation": "Sorry, I am sorry",
          "explanation": "\"Pardon\" is a quick apology; \"désolé\" sounds more sincere."
        }
      ]
    },
