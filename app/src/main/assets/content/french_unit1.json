      "exercises": [
        {
          "type": "multiple_choice",
          "prompt": "How do you say \"My name is…\"?",
          "options": ["Je m'appelle…", "J'ai…", "Je suis…", "Je vais…"],
          "correctIndex": 0,
          "explanation": "\"Je m'appelle\" literally means \"I call myself\"."
        },
        {
          "type": "match_pairs",
          "pairs": [["Je m'appelle Marie", "My name is Marie"], ["Et toi ?", "And you?"], ["Enchanté", "Nice to meet you"], ["D'où viens-tu ?", "Where are you from?"]],
          "explanation": "\"Et toi ?\" bounces a question back informally."
        },
        {
          "type": "multiple_choice",
          "prompt": "What does \"Comment tu t'appelles ?\" mean?",
          "options": ["What's your name? (informal)", "How are you?", "Where do you live?", "How old are you?"],
          "correctIndex": 0,
          "explanation": "Literally \"how do you call yourself?\" — informal, for friends."
        },
        {
          "type": "fill_blank",
          "sentence": "Je ___ française",
          "answer": "suis",
          "wordBank": ["suis", "es", "ai", "va"],
          "explanation": "\"Je suis\" means \"I am\" — nationality uses être (to be)."
        },
        {
          "type": "listening",
          "text": "Je viens d'Angleterre",
          "options": ["I come from England", "I live in England", "I like England", "I work in England"],
          "correctIndex": 0,
          "explanation": "\"Je viens de…\" means \"I come from…\"."
        },
        {
          "type": "multiple_choice",
          "prompt": "Which reply means \"I am twenty years old\"?",
          "options": ["J'ai vingt ans", "Je suis vingt", "J'ai deux ans", "Je vingt ans"],
          "correctIndex": 0,
          "explanation": "French uses \"avoir\" (to have) for age: \"j'ai vingt ans\" = \"I have twenty years\"."
        },
        {
          "type": "fill_blank",
          "sentence": "___ vous appelez-vous ?",
          "answer": "Comment",
          "wordBank": ["Comment", "Combien", "Quand", "Pourquoi"],
          "explanation": "\"Comment vous appelez-vous ?\" is the formal way to ask someone's name."
        },
        {
          "type": "pronunciation",
          "expected": "Je m'appelle Alex, enchanté !",
          "translation": "My name is Alex, nice to meet you!",
          "explanation": "Link \"m'appelle\" smoothly — French connects words in speech."
        }
      ]
    },
    {
