        },
        {
          "type": "multiple_choice",
          "prompt": "The waiter asks \"Was möchten Sie trinken?\" What does it mean?",
          "options": ["What would you like to drink?", "Where do you want to go?", "Do you like the food?", "How much do you want?"],
          "correctIndex": 0,
          "explanation": "\"Möchten\" = would like — the polite order-taking question."
