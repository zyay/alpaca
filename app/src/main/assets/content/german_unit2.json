        {
          "type": "listening",
          "text": "Einen Kaffee mit Milch, bitte",
          "options": ["A coffee with milk, please", "A coffee without milk, please", "A tea with milk, please", "A coffee with sugar, please"],
          "correctIndex": 0,
          "explanation": "\"Mit Milch\" = with milk; \"ohne\" = without."
        },
        {
          "type": "multiple_choice",
          "prompt": "How do you order \"for me\" after a friend orders?",
          "options": ["Für mich auch…", "Ich auch kaufen…", "Mit mir…", "Zu mir…"],
          "correctIndex": 0,
          "explanation": "\"Für mich\" = for me — add \"auch\" (too) to copy an order."
        },
        {
          "type": "fill_blank",
          "sentence": "Ein Wasser ___ Kohlensäure, bitte",
          "answer": "ohne",
          "wordBank": ["ohne", "mit", "für", "von"],
          "explanation": "\"Ohne Kohlensäure\" = without carbonation — still water."
        },
        {
          "type": "pronunciation",
          "expected": "Einen Kaffee, bitte!",
          "translation": "A coffee, please!",
          "explanation": "\"Einen\" has a clear -n ending: eye-nen."
