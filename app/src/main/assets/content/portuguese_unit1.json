        },
        {
          "type": "multiple_choice",
          "prompt": "How do you say your age? \"Tenho vinte ___\"",
          "options": ["anos", "ano", "anos e", "vezes"],
          "correctIndex": 0,
          "explanation": "Age uses \"ter\" (to have): \"tenho vinte anos\" — I have twenty years."
        },
