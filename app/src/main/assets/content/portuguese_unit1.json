        },
        {
          "type": "listening",
          "text": "Como está?",
          "options": ["How are you? (formal)", "What's your name?", "Where are you from?", "How old are you?"],
          "correctIndex": 0,
          "explanation": "\"Como está?\" is the polite form; with friends, \"Como estás?\"."
        },
        {
          "type": "multiple_choice",
          "prompt": "How do you say \"Goodbye\"?",
          "options": ["Adeus", "Olá", "Sim", "Prazer"],
          "correctIndex": 0,
          "explanation": "\"Adeus\" — literally \"to God\" — is the full goodbye; \"tchau\" is casual."
        },
        {
          "type": "fill_blank",
          "sentence": "Até ___!",
          "answer": "amanhã",
          "wordBank": ["amanhã", "ontem", "hoje", "nunca"],
          "explanation": "\"Até amanhã\" — see you tomorrow. \"Até logo\" is see you later."
        },
        {
          "type": "pronunciation",
          "expected": "Prazer em conhecê-lo",
          "translation": "Pleased to meet you",
          "explanation": "\"Prazer\" alone also works — it means \"pleasure\"."
        }
      ]
