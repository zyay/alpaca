          "prompt": "What does \"на этой неделе\" mean?",
          "options": ["This week", "Next week", "Last week", "Every week"],
          "correctIndex": 0,
          "explanation": "\"На этой неделе\" = this week; swap to \"на следующей\" for next week."
        },
