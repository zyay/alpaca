        {
          "type": "multiple_choice",
          "prompt": "How do you ask for the bill?",
          "options": ["Можно счёт?", "Где деньги?", "Я плачу нет", "Счёт есть?"],
          "correctIndex": 0,
          "explanation": "\"Можно счёт?\" — may I have the bill? Short, polite, universal."
        },
        {
          "type": "pronunciation",
          "expected": "Мне кофе без сахара, пожалуйста",
          "translation": "A coffee without sugar, please",
          "explanation": "\"Без + genitive\" = without: без сахара, без молока."
