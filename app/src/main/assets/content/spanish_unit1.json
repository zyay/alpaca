          "text": "¿Cómo estás?",
          "options": ["How are you?", "What's your name?", "Where are you from?", "How old are you?"],
          "correctIndex": 0,
          "explanation": "\"¿Cómo estás?\" is the informal way to ask how someone is doing."
        },
        {
          "type": "multiple_choice",
          "prompt": "How do you say \"Good night\"?",
          "options": ["Buenas noches", "Buenos días", "Buenas tardes", "Hasta luego"],
          "correctIndex": 0,
          "explanation": "\"Buenas noches\" is used in the evening and before bed."
        },
        {
          "type": "fill_blank",
          "sentence": "Hasta ___",
