          "wordBank": ["luego", "hola", "bien", "gracias"],
          "explanation": "\"Hasta luego\" means \"see you later\"."
        },
        {
          "type": "pronunciation",
          "expected": "Mucho gusto",
          "translation": "Nice to meet you",
          "explanation": "\"Mucho gusto\" literally means \"much pleasure\"."
        },
        {
          "type": "listening",
          "text": "¡Buenos días!",
          "options": ["Good morning!", "Good night!", "See you later!", "Welcome!"],
          "correctIndex": 0,
          "explanation": "\"Buenos días\" greets people in the morning."
        },
        {
          "type": "multiple_choice",
          "prompt": "What does \"Por favor\" mean?",
          "options": ["Please", "Thank you", "Excuse me", "Of course"],
          "correctIndex": 0,
          "explanation": "\"Por favor\" means \"please\" — pair it with \"gracias\"."
        }
      ]
